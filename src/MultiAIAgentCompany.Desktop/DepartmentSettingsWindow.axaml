<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiAIAgentCompany.Desktop"
        xmlns:agents="clr-namespace:MultiAIAgentCompany.Core.Agents;assembly=MultiAIAgentCompany.Core"
        x:Class="MultiAIAgentCompany.Desktop.DepartmentSettingsWindow"
        x:DataType="vm:DepartmentSettingsViewModel"
        Title="部門の設定" Width="820" Height="620"
        Background="{DynamicResource AppBackgroundBrush}">

    <DockPanel Margin="12">

        <!-- 結果は必ず出す（設計 §28-1）。保存も削除も、黙って失敗させない。 -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasMessage}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="10" Margin="0,10,0,0">
            <SelectableTextBlock Text="{Binding Message}" Classes="body" TextWrapping="Wrap" />
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                    HorizontalAlignment="Right">
            <Button Content="閉じる" Classes="quiet" Click="OnClose" />
            <Button Content="保存する" Classes="primary" Click="OnSave" />
        </StackPanel>

        <!-- 秘書（設計 §46-3）。部門と同じ窓に置く —— どの CLI が何を担当するかは、
             一覧で見える方が分かりやすい。 -->
        <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,10,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="秘書" Classes="title" />
                <TextBlock Classes="caption"
                           Text="中央ペインで話す相手。Antigravity は選べません（headless では承認を人間に聞けないため）。" />
                <!-- 並びは CLI → モデル → 思考の強さ → 権限モード（人間の要望、2026-09-21）。 -->
                <Grid ColumnDefinitions="Auto,180,Auto,*,Auto,140,Auto,160" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="CLI" Classes="meta" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SecretaryChoices}"
                              SelectedItem="{Binding SecretaryAgent}" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="2" Text="モデル" Classes="meta" VerticalAlignment="Center" Margin="12,0,8,0" />

                    <!-- **部門と同じ形で選ばせる**（設計 §62-21、人間の要望）。
                         **候補が出ていても打ち込める**（§62-23）—— 候補は別名なので、
                         版を固定したい人はフルのモデル ID を打つ。 -->
                    <StackPanel Grid.Column="3" Spacing="4">
                        <ComboBox ItemsSource="{Binding SecretaryModelChoices}"
                                  SelectedItem="{Binding SecretarySelectedModel}"
                                  IsVisible="{Binding HasSecretaryModelChoices}" HorizontalAlignment="Stretch" >
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="agents:AgentModelChoice">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Text="{Binding SecretaryModel}" Classes="input"
                                 PlaceholderText="空欄なら CLI の設定に任せる（候補に無い ID も打てる）" />
                    </StackPanel>

                    <TextBlock Grid.Column="4" Text="強さ" Classes="meta" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <ComboBox Grid.Column="5" ItemsSource="{Binding SecretaryEffortChoices}"
                              SelectedItem="{Binding SecretaryEffort}"
                              IsVisible="{Binding HasSecretaryEffortChoices}" HorizontalAlignment="Stretch" />
                    <TextBox Grid.Column="5" Text="{Binding SecretaryEffort}" Classes="input"
                             IsVisible="{Binding !HasSecretaryEffortChoices}" PlaceholderText="空欄可" />

                    <!-- **CLI が持つモードだけ**（設計 §51-2 / §62-22、人間の要望）。 -->
                    <TextBlock Grid.Column="6" Text="権限モード" Classes="meta" VerticalAlignment="Center"
                               Margin="12,0,8,0" />
                    <ComboBox Grid.Column="7" ItemsSource="{Binding SecretaryPermissionModeChoices}"
                              SelectedItem="{Binding SecretarySelectedPermissionMode}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PermissionModeChoice">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- **黙って弱めない**（設計 §62-22）。「自動」はアプリの承認カードを通らない。 -->
                <TextBlock Text="{Binding SecretaryPermissionModeWarning}"
                           IsVisible="{Binding HasSecretaryPermissionModeWarning}"
                           Classes="caption" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" />

                <!-- **選んだ CLI の trust を出す**（設計 §54-2）。秘書を Codex にしたら Codex のもの。 -->
                <TextBlock Text="{Binding SecretaryTrustText}" Classes="caption" TextWrapping="Wrap" />

                <!-- **アプリ全体の好み**（設計 §62-25）。部門ごとではないので、ここに1つだけ置く。 -->
                <CheckBox IsChecked="{Binding CloseTerminalsWhenDone}" Margin="0,4,0,0"
                          Content="仕事が終わった部門のターミナルの窓を閉じる（中で動いている窓は閉じません）" />
            </StackPanel>
        </Border>

        <!-- 左: 部門の一覧。右: 中身。 -->
        <Grid ColumnDefinitions="240,12,*">
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Content="＋ 追加" Classes="quiet" Click="OnAdd" />
                    <Button Content="削除" Classes="quiet" Click="OnRemove"
                            IsVisible="{Binding HasSelection}" />
                    <!-- **並べ替え**（人間の要望、2026-09-13）。右ペインのタイルもこの順になる。 -->
                    <Button Content="↑" Classes="quiet" Click="OnMoveUp" ToolTip.Tip="上へ"
                            IsVisible="{Binding HasSelection}" />
                    <Button Content="↓" Classes="quiet" Click="OnMoveDown" ToolTip.Tip="下へ"
                            IsVisible="{Binding HasSelection}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Departments}" SelectedItem="{Binding Selected}"
                         Background="{DynamicResource PaneBackgroundBrush}"
                         BorderThickness="0" CornerRadius="{StaticResource CardRadius}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DepartmentEdit">
                            <StackPanel Spacing="2" Margin="2,4">
                                <TextBlock Text="{Binding DisplayName}" Classes="title" />
                                <TextBlock Text="{Binding Id}" Classes="meta" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- **IsVisible は DataContext を差し替える前の要素で見る。**
                 同じ要素に置くと、差し替えた後（DepartmentEdit）で解決しようとする。 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="10"
                            DataContext="{Binding Selected}" x:DataType="vm:DepartmentEdit">

                    <TextBlock Text="{Binding Title}" Classes="title" />

                    <!-- **Id は新規のときだけ**（設計 §47）。state.json は departmentId しか
                         持たないので、変えるのは「別の部門にする」ことになる。 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Id" Classes="meta" />
                        <TextBox Text="{Binding Id}" Classes="input" IsEnabled="{Binding IsNew}" />
                        <TextBlock Classes="caption" IsVisible="{Binding !IsNew}"
                                   Text="既にある部門の Id は変えられません（過去の仕事が指しているため）。" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="表示名" Classes="meta" />
                        <TextBox Text="{Binding DisplayName}" Classes="input" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="責務（1行）" Classes="meta" />
                        <TextBox Text="{Binding Responsibility}" Classes="input"
                                 PlaceholderText="この部門が何をするか" />
                    </StackPanel>

                    <!-- 並びは CLI → モデル → 思考の強さ → 権限モード（人間の要望、2026-09-21）。 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="CLI" Classes="meta" />
                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:DepartmentSettingsViewModel)DataContext).AgentChoices}"
                                  SelectedItem="{Binding Agent}" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="モデル" Classes="meta" />

                        <!-- **一覧が取れる CLI では、一覧から選ばせる**（設計 §47-2）。
                             取れないものは自由入力のまま —— それらしく埋めない（§7）。 -->
                        <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel}"
                                  IsVisible="{Binding HasModelChoices}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="agents:AgentModelChoice">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Id}" Classes="meta" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- **候補が出ていても打ち込める**（設計 §62-23）。候補は「その系列の最新」を指す
                             別名なので、版を固定したい人はフルのモデル ID を打つ。 -->
                        <TextBox Text="{Binding Model}" Classes="input"
                                 PlaceholderText="空欄なら CLI の設定に任せる（候補に無い ID も打てる）" />
                        <TextBlock Text="{Binding ModelHint}" Classes="caption" />
                    </StackPanel>

                    <!-- **Antigravity では出さない**（設計 §47-2、実機で分かった）——
                         あちらは強さがモデル名に畳まれていて、effort の旗を付けると弾かれる。 -->
                    <StackPanel Spacing="4" IsVisible="{Binding SupportsEffort}">
                        <TextBlock Text="思考の強さ" Classes="meta" />
                        <ComboBox ItemsSource="{Binding EffortChoices}" SelectedItem="{Binding ReasoningEffort}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <!-- **CLI が持つ権限モードだけ選べる**（設計 §51-2）。 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="権限モード" Classes="meta" />
                        <ComboBox ItemsSource="{Binding PermissionModeChoices}"
                                  SelectedItem="{Binding SelectedPermissionMode}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PermissionModeChoice">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- **選んだモードが効かないモデルでは言う**（設計 §51-4、実機で分かった）。
                             Claude は haiku で「自動」を黙って通常モードに戻す。 -->
                        <TextBlock Text="{Binding PermissionModeWarning}" IsVisible="{Binding HasPermissionModeWarning}"
                                   Classes="caption" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="報告を待つ分数" Classes="meta" />
                            <TextBox Text="{Binding ReportDeadlineMinutes}" Classes="input"
                                     PlaceholderText="空欄なら 30 分" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                            <CheckBox IsChecked="{Binding ReadsOnly}" Content="読むだけ（書き込み権を取らない）" />
                        </StackPanel>
                    </Grid>

                    <!-- 駆動モードは選ばせない（§46）。**残っていたときだけ**直す口を出す。 -->
                    <Border Classes="card" IsVisible="{Binding IsStructured}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="この部門は構造化で動く設定になっています" Classes="title" />
                            <TextBlock Classes="caption"
                                       Text="承認がこの窓ではなくアプリ内のボタンに出ます。いまの設計は外部ターミナルで人間が押す形に揃えてあります。" />
                            <Button Content="外部ターミナルに直す" Classes="quiet" Click="OnUseTerminal"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
