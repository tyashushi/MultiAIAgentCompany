<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MultiAIAgentCompany.Desktop"
        xmlns:core="using:MultiAIAgentCompany.Core.Coordination"
        DragDrop.AllowDrop="True"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MultiAIAgentCompany.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="800"
        Title="MultiAIAgentCompany"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- フォントは `Themes/Typography.axaml` の `Window` セレクタで**全部の窓に**当てる
         （§44-6）。ここに書くと、書き忘れた窓だけが化ける。 -->

    <!-- 3ペイン（設計 §1）。左＝作業ログ、中央＝秘書との会話、右＝部門ステータス。 -->
    <!-- macOS の標準メニュー（設計 §28-7）。ショートカットの所在をここで示す ——
         キーだけ足しても、人間はそれが在ることを知らない。 -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="ファイル">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="フォルダを選ぶ…" Gesture="{OnPlatform Default=Cmd+O, Windows=Ctrl+O}"
                                        Click="OnPickWorkspaceFromMenu" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="部門の設定…" Click="OnShowDepartmentSettings" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{OnPlatform Default='いま開いているフォルダを Finder で開く', Windows='いま開いているフォルダをエクスプローラーで開く'}"
                                        Gesture="{OnPlatform Default=Cmd+Shift+O, Windows=Ctrl+Shift+O}"
                                        Click="OnRevealWorkspace" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="表示">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="もう一度走査する" Gesture="{OnPlatform Default=Cmd+R, Windows=Ctrl+R}" Click="OnRescanFromMenu" />
                        <NativeMenuItem Header="作業ログを消す" Click="OnClearWorkLog" />
                        <NativeMenuItem Header="直近のエラーの詳細を出す" Click="OnShowLastErrors" />
                        <NativeMenuItem Header="会話を全部コピーする" Gesture="{OnPlatform Default=Cmd+Shift+C, Windows=Ctrl+Shift+C}" Click="OnCopyTranscript" />
                        <NativeMenuItem Header="作業ログを全部コピーする" Gesture="{OnPlatform Default=Cmd+Shift+L, Windows=Ctrl+Shift+L}" Click="OnCopyWorkLog" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="アイコンの一覧を見る" Click="OnShowIconGallery" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="入力欄へ移動" Gesture="{OnPlatform Default=Cmd+L, Windows=Ctrl+L}" Click="OnFocusMessage" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <!-- **Windows には画面上部のメニューバーが無い**（2026-09-14、実機で確かめた）。
         `NativeMenu` だけだと、部門の設定やエラーの詳細に**入口が無くなる**。
         `NativeMenuBar` は、OS のメニューに出せる macOS では隠れ、出せない OS では窓の中に同じメニューを描く。 -->
    <DockPanel>
    <NativeMenuBar DockPanel.Dock="Top" />

    <Grid x:Name="PaneGrid" ColumnDefinitions="260,4,*,4,320" Margin="8">

        <Border Grid.Column="0" Classes="pane">
        <DockPanel>
            <!-- 起動時の復旧走査（設計 §14-1 / §16-3）。**一過性のログ行にしない** ——
                 流れて消えると、自動再送しない契約を人間が守れない。
                 Unreadable は部門に紐づけられないので、ここにしか出せない。 -->
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasRecovery}" Margin="0,0,0,8">
                <TextBlock Text="確かめてほしいこと" FontWeight="Bold" Margin="0,0,0,4" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                <ItemsControl ItemsSource="{Binding Recovery}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RecoveryItem">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold">
                                        <Run Text="{Binding KindText}" /><Run Text=" — " /><Run Text="{Binding Slug}" />
                                    </TextBlock>
                                    <SelectableTextBlock Text="{Binding Detail}" FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap" Opacity="0.8" />

                                    <!-- 人間が決めた結果を記録できるようにする（設計 §16-4）。
                                         「まだ決めない」は選択肢を出さない —— 何もしなければ残る。 -->
                                    <WrapPanel IsVisible="{Binding IsMaybeSent}" Margin="0,4,0,0">
                                        <Button Content="受け取って作業中だった" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryConfirmDelivered" />
                                        <Button Content="もう一度送る（二重に実行されるかも）" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryResend" />
                                        <Button Content="アプリ上で取り消す" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryCancel" />
                                    </WrapPanel>

                                    <!-- 前回の残りの窓（設計 §62-25）。**押したときに数え直す。** -->
                                    <WrapPanel IsVisible="{Binding IsLeftoverTerminals}" Margin="0,4,0,0">
                                        <Button Content="片付ける（窓を閉じる）" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryCloseTerminals" />
                                    </WrapPanel>

                                    <!-- 読めない lease（設計 §23-1）。**自動で作り直さない** ——
                                         読めない lease は「誰も持っていない」ではなく
                                         「持ち主を検証できない」。 -->
                                    <WrapPanel IsVisible="{Binding IsUnreadableLease}" Margin="0,4,0,0">
                                        <Button Content="フォルダを開く" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="隔離して空の書き込み権を作る" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryIsolateLease" />
                                        <Button Content="もう一度読む" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>

                                    <!-- 失効した書き込み権（設計 §24-2）。**時間では空かない。**
                                         外す根拠は時間ではなく、人間が「もう動いていない」と
                                         判断したこと（§14-2）。 -->
                                    <WrapPanel IsVisible="{Binding IsExpiredLease}" Margin="0,4,0,0">
                                        <Button Content="失効した書き込み権を外す" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryReleaseExpiredLease" />
                                        <Button Content="フォルダを開く" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="もう一度読む" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>

                                    <!-- 設定の話は**人間が直す**（設計 §32-10）。
                                         アプリは departments.json を書き換えない（§30-4 / §30-6）ので、
                                         出すのは開く手立てだけ。 -->
                                    <WrapPanel IsVisible="{Binding IsConfiguration}" Margin="0,4,0,0">
                                        <Button Content="フォルダを開く" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="もう一度読む" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>

                                    <WrapPanel IsVisible="{Binding IsUnreadable}" Margin="0,4,0,0">
                                        <Button Content="フォルダを開く" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="隔離する" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryQuarantine" />
                                        <Button Content="もう一度読む" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- **作業ログは畳んで下へ**（設計 §32-6）。左ペインの主役は相談スレッド ——
                 初期ブリーフの「左＝チャットログ一覧」を、途中で
                 「システムの作業実行ログ」と取り違えていた。 -->
            <Expander DockPanel.Dock="Bottom" Classes="log" IsExpanded="False" Margin="0,8,0,0"
                      FontSize="{DynamicResource FontSizeSmall}">
                <Expander.Header>
                    <TextBlock Text="作業ログ" Classes="section" />
                </Expander.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="220">
                    <!-- **1つの部品にまとめる**（人間の要望、2026-09-12）——
                         1行ずつ別の部品にすると、**ドラッグで行をまたいで選べない。**
                         会話では §34-4 で既に解いていた問題（§37-10）。 -->
                    <SelectableTextBlock Text="{Binding WorkLogText}" TextWrapping="Wrap" Margin="0,2"
                                         FontSize="{DynamicResource FontSizeSmall}"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                </ScrollViewer>
            </Expander>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="相談" Classes="section" VerticalAlignment="Center" />
                <Button Content="＋ 新しい相談" Click="OnNewThread" HorizontalAlignment="Right"
                        Classes="quiet" />
            </DockPanel>

            <!-- **相談が無いときだけ一言**（設計 §52-2）。 -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding NoThreadsQuip}" Classes="caption"
                       IsVisible="{Binding !HasThreads}" Margin="0,0,0,8" />

            <!-- **スクロールできること**（設計 §25-1）。無いと、はみ出した行に手が届かない。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Threads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- **行は枠を持たない**（設計 §44）。ホバーと選択のときだけ面が付く。
                                 枠で囲むと、7行並んだときに「箱の列」に見える。 -->
                            <Button Click="OnThreadSelected" Classes="row" Margin="0,1"
                                    Classes.selected="{Binding IsSelected}">
                                <StackPanel Spacing="2">
                                    <DockPanel>
                                        <!-- 選んでいるものに印を付ける。**色に頼らない**
                                             （§28 でローカライズはやらないと決めたのと同じ姿勢で、
                                             見分けは形で付ける）。 -->
                                        <TextBlock Text="▸ " IsVisible="{Binding IsSelected}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                    <DockPanel>
                                        <!-- **片付けるのは、選んでいる相談だけ**（設計 §45）。
                                             全部の行に出すと、一覧が操作だらけになる。
                                             **消すのではない** —— `.company/archive/threads/` へ移る。 -->
                                        <Button DockPanel.Dock="Right" Content="片付ける"
                                                IsVisible="{Binding IsSelected}"
                                                Click="OnArchiveThread" Classes="quiet"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UpdatedText}" Classes="meta"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="秘書" Classes="title" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceLabel}" Classes="meta"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" x:Name="PickWorkspaceButton" Click="OnPickWorkspace"
                            Content="フォルダを選ぶ" Classes="quiet" Margin="8,0,0,0" />
                </Grid>

                <!-- trust は3値（設計 §13-9）。「未 trust」と「判定できない」を同じにしない ——
                     読めていないだけなのに、人間へ無用な操作を促すことになる。
                     アプリは trust を書かない。どこで与えるかを伝えるに留める。 -->
                <ItemsControl ItemsSource="{Binding Trust}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:TrustRow">
                            <Grid ColumnDefinitions="110,90,*,Auto" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding AgentText}" FontSize="{DynamicResource FontSizeSmall}" />
                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Text="{Binding ActionText}" FontSize="{DynamicResource FontSizeSmall}"
                                           Opacity="0.75" TextWrapping="Wrap" />
                                <!-- **信頼を与える場所まで連れて行く**（設計 §54、人間の要望）。
                                     アプリは trust を書かない（§13-9）—— 開くだけで、与えるのは人間。 -->
                                <Button Grid.Column="3" Content="ターミナルで開く" Classes="quiet"
                                        FontSize="{DynamicResource FontSizeSmall}" Margin="8,0,0,0"
                                        IsVisible="{Binding CanOpenTerminal}" Click="OnOpenTrustTerminal" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--
                入力欄経由でのみ文章を送る（設計 §13-7）。ターミナルに直接打たせない。
                実測: TerminalView は IME の変換中でもキーから作った文字を即 PTY へ送るため、
                「?」や Enter が漏れる。TextBox 経路なら確定文字だけが入る。
                また IME の変換確定 Enter は KeyDown として届かないので、
                入力欄では素の Enter を送信に使ってよい。
            -->
            <!-- **これは調整基盤の経路ではない**（§6 / §14-1）——
                 本来は秘書が instruction.md を書き、アプリが dispatch する。
                 ここは配線を実物で確かめるための直通路。秘書はまだ繋がっていない。 -->
            <!-- ボタンは2つ。**文言が何をするか言う**（設計 §16-2 / §15-6）——
                 「送信」では、仕事を作るのかただの一言なのかが分からない。 -->
            <!-- **中央の入力欄は秘書だけのもの**（設計 §17-4）。
                 同じ入力欄が秘書・部門・仕事作成という複数の文脈を背負うと §0 / §1 と衝突する。
                 部門への操作は右ペインへ移した。 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <!-- 走っている計画（設計 §37）。**人間の出番は割り込みだけ** ——
                     報告は出た瞬間に中央へ出るので、読んでいてまずいと思ったら止める。
                     **止めるのは「次を渡さない」こと。走っている窓は閉じない**（§32-8）。
                     **「続ける」を一緒に出す** —— 無いと、一度止めた計画を
                     進める手段が画面から消える（§19-1 / §30-2 で3度踏んだ形）。 -->
                <Border IsVisible="{Binding HasPlan}" Margin="0,0,0,6" Padding="8" CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <!-- **選んでコピーできるようにする**（人間の要望、2026-09-12）——
                             ここに出るのは**渡せなかった理由**で、人間はそれを人に見せたり
                             調べたりする。読めるだけでは足りない（作業ログは §34-4 で既にそう）。 -->
                        <SelectableTextBlock Grid.Column="0" Text="{Binding PlanStatus}" TextWrapping="Wrap"
                                             FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="計画を止める" Margin="8,0,0,0"
                                    IsVisible="{Binding PlanRunning}" Click="OnStopPlan" />
                            <Button Content="計画を続ける" Margin="8,0,0,0"
                                    IsVisible="{Binding PlanStopped}" Click="OnResumePlan" />
                            <!-- **行き止まりの計画を画面から降ろす**（設計 §62-32）。
                                 止めているときだけ出す —— 動いている計画は、まず止めてから。
                                 **消さずに archive へ移す**（§16-4）ので、押し間違えても戻せる。 -->
                            <Button Content="計画を片付ける" Classes="quiet" Margin="8,0,0,0"
                                    ToolTip.Tip="この計画を .company/archive/plans/ へ移す（仕事の記録は消えない）"
                                    IsVisible="{Binding PlanStopped}" Click="OnArchivePlan" />
                        </StackPanel>

                        <!-- **工程の一覧**（設計 §62-27、人間の要望）。1行だけでは
                             「8工程のどこで止まったのか」が分からなかった（実機で踏んだ）。 -->
                        <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding PlanSteps}"
                                      IsVisible="{Binding HasPlanSteps}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PlanStepRow">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,1,0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding Mark}" Width="18"
                                                   FontSize="{DynamicResource FontSizeSmall}" />
                                        <!-- **同時に走る組を絵で見せる**（設計 §62-33）。
                                             文字で「同時」と書くと、8工程で行が読みにくくなる。 -->
                                        <TextBlock Grid.Column="1" Text="{Binding WaveMark}" Width="12"
                                                   ToolTip.Tip="前の工程と同時に走る"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Head}" Margin="0,0,8,0"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   FontWeight="{Binding Weight}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                                        <!-- **まだ渡していない工程だけ動かせる**（設計 §62-35）。
                                             渡した工程にボタンを出すと、押せるのに毎回断られる。 -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2"
                                                    IsVisible="{Binding CanEdit}">
                                            <Button Content="⇅" Classes="quiet" Padding="6,0"
                                                    FontSize="{DynamicResource FontSizeSmall}"
                                                    ToolTip.Tip="{Binding RunsWithPreviousTip}"
                                                    IsVisible="{Binding CanRunWithPrevious}"
                                                    Click="OnPlanStepWave" />
                                            <Button Content="↑" Classes="quiet" Padding="6,0"
                                                    FontSize="{DynamicResource FontSizeSmall}"
                                                    ToolTip.Tip="上へ" Click="OnPlanStepUp" />
                                            <Button Content="↓" Classes="quiet" Padding="6,0"
                                                    FontSize="{DynamicResource FontSizeSmall}"
                                                    ToolTip.Tip="下へ" Click="OnPlanStepDown" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- turn の終わりを期限までに観測していない（設計 §36）。
                     **状態は動かしていない** —— 出しているのは「観測していない」という
                     アプリ自身についての事実で、秘書が止まったとは言っていない（§31-5）。
                     用件は1つだけ: **観測できる終端を作る**（= プロセスを終わらせる）。 -->
                <Border IsVisible="{Binding SecretaryStalled}" Margin="0,0,0,6" Padding="8" CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <SelectableTextBlock Grid.Column="0" Text="{Binding SecretaryStalledText}" TextWrapping="Wrap"
                                             FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="秘書を立て直す" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="OnRestartSecretary" />
                    </Grid>
                </Border>
                <SelectableTextBlock Text="{Binding SecretaryStatus}" Classes="body"
                                     FontSize="{DynamicResource FontSizeSmall}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     TextWrapping="Wrap" Margin="0,0,0,6" />

                <!-- **考えている印**（設計 §62-26、人間の要望）。観測した turn をそのまま出す。 -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6"
                            IsVisible="{Binding SecretaryThinking}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SecretaryThinkingText}" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 送る前の添付（設計 §58-6）。**外せるようにする** —— 落とし間違いを送らない。 -->
                <ItemsControl ItemsSource="{Binding PendingAttachments}" IsVisible="{Binding HasPendingAttachments}"
                              Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="core:AttachmentDraft">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,2,2,2" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeSmall}" MaxWidth="240"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
                                    <TextBlock Text="{Binding Length, Converter={x:Static vm:AttachmentSize.Converter}}"
                                               VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Content="×" Classes="quiet" Padding="6,0"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            ToolTip.Tip="この添付を外す" Click="OnRemoveAttachment" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto">
                    <!-- **複数行を書ける**（設計 §62-28）。`AcceptsReturn="False"` の TextBox は
                         **貼り付けを最初の改行で切り捨てる**（Avalonia の `SanitizeInputText`）ので、
                         箇条書きの依頼を貼ると1行しか入らなかった。
                         **Enter は改行、Shift+Enter で送る**（人間が決めた）。IME の確定 Enter は
                         KeyDown として届かないので、確定で改行も送信も起きない。
                         送信は Tunnel で先に取る（code-behind を見よ）ので、
                         ここに `KeyDown="..."` は書かない —— 書くと TextBox が先に食う。 -->
                    <TextBox Grid.Column="0" x:Name="MessageBox" AcceptsReturn="True"
                             TextWrapping="Wrap" MaxHeight="160" VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Classes="input"
                             PlaceholderText="秘書に相談する（Shift+Enter で送る。ファイルは窓に落とすと添付）" />
                    <!-- 未起動なら、その副作用として起動する（§17-4）。
                         **画面でいちばん強い操作はこれ1つ**（設計 §44）。 -->
                    <!-- **入力欄が伸びてもボタンは伸ばさない**（§62-28）。
                         下端に揃えておくと、何行書いても押す場所が動かない。 -->
                    <Button Grid.Column="1" Content="秘書に送る" Classes="primary"
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,0" Click="OnSendToSecretary" />
                </Grid>
            </StackPanel>

            <!-- 秘書の提案（設計 §17-6 / §34-1）。
                 **提案は publish されると自動で仕事になる**（§34-1）ので、
                 ここに並ぶのは**自動にできなかったもの**（宛先が分からない等）か、
                 走査が拾うまでの短い間だけ。**捨てないので、理由と一緒に出す。** -->
            <!-- 提案も同じ（§25-1）。増えたら会話が見えなくなるので高さを区切る。 -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="260">
            <ItemsControl ItemsSource="{Binding Proposals}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProposalCard">
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="秘書からの提案 → " /><Run Text="{Binding TargetText}" />
                                </TextBlock>
                                <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                           Margin="0,2,0,0" MaxHeight="120" />
                                <WrapPanel Margin="0,6,0,0">
                                    <!-- 宛先が分からない提案は仕事にできない。**捨てもしない**（§17-6）。 -->
                                    <!-- 自動で拾えなかったときの手動の口（§34-1）。 -->
                                    <Button Content="仕事にする" IsEnabled="{Binding CanMakeTask}"
                                            FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,0" Click="OnProposalAccept" />
                                    <Button Content="やめる" FontSize="{DynamicResource FontSizeSmall}" Click="OnProposalReject" />
                                </WrapPanel>
                                <SelectableTextBlock Text="{Binding ProblemText}"
                                           IsVisible="{Binding HasProblem}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- (a) ランタイム承認。ボタンは提示された決定から作る（設計 §5）——
                 版で変わる語彙をここに書き足さない。
                 (b) 判断の相談はここに出さない。あれは .company/ のファイルで扱う（§3 / §6）。 -->
            <!-- **承認は画面外に出してはいけない**（設計 §25-1 / §15-6）。数が増えると
                 ボタンが下へ押し出されて押せなくなる。高さを区切ってスクロールさせる。 -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="260">
            <ItemsControl ItemsSource="{Binding Approvals.Pending}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PendingApproval">
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                BorderThickness="2" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="承認まち: " /><Run Text="{Binding DepartmentName}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8" />

                                <!-- 「今回だけ / 常に許可」の材料（§13-1）。安全な要約だけで、
                                     ツールの入力そのものは含まない（§10）。v1 は読むだけ。 -->
                                <ItemsControl ItemsSource="{Binding SuggestedRules}"
                                              IsVisible="{Binding HasSuggestions}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Decisions}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,6,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:PendingApproval)DataContext).RespondCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 返事が届かなかったことを、届いたことにしない。 -->
                                <SelectableTextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                                                     TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                                     Margin="0,4,0,0" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- **最初に何をすればよいかを出す**（設計 §28-2）。フォルダを選ぶまでは
                 中央に説明を置く —— 空の3ペインだけだと、初見では何をするか分からない。 -->
            <!-- **上に置く**（2026-09-19、実機で発覚）。置き場所を書かないと DockPanel は左に置き、
                 会話の面が右端の細い隙間に押し込まれて、ひと言が1字ずつ縦に並んでいた。 -->
            <Border DockPanel.Dock="Top" IsVisible="{Binding !HasWorkspace}" Margin="0,0,0,8" Padding="16"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <!-- **何も無いときだけ遊ぶ**（設計 §52-2）。説明文は削らない。 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <Image Source="{Binding RestingPoseImage}" Width="64" Height="64" />
                        <TextBlock Text="{Binding NoWorkspaceQuip}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeLarge}" />
                    </StackPanel>
                    <TextBlock Text="AI たちを部門として働かせるアプリです" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarge}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85"
                               Text="Claude Code / Codex CLI / Antigravity CLI を「部門」として扱います。あなたは秘書と会話し、秘書が仕事を各部門に渡します。" />
                    <TextBlock Text="はじめかた" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="1. 右上の「フォルダを選ぶ」で、AI たちに作業させるフォルダを選ぶ" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="2. 左下に各 CLI の状態が出ます（見つからない / 未 trust なら、そこに対処が書いてあります）" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="3. 下の入力欄から秘書に話しかける。部門は右のパネルから起動します" />
                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7"
                               Text="※ 選んだフォルダの .company/ を通じて、アプリと部門がやりとりします。アプリを閉じると、起動した CLI もすべて終了します。" />
                </StackPanel>
            </Border>

            <!-- **枠ではなく面で置く**（設計 §44）。中央は地より明るくして、左右のペインと分ける。 -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource CardRadius}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <!-- 会話は下に伸びるので、新しい発言が来たら最下部へ追う（§25-1）。 -->
                <Panel>
                <!-- **空のときは真ん中に薄く**（設計 §44）。左上に1行だけ置くと、
                     広い面が「白い空洞」に見える。 -->
                <!-- **ロボットと一言を添える**（設計 §52-2）。何をすればよいかの一文は残す。 -->
                <StackPanel IsVisible="{Binding !HasTranscript}" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding ConsultingPoseImage}" Width="80" Height="80" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyTranscriptQuip}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="まだ何も話していません。秘書に相談すると、ここに会話が出ます"
                               Classes="caption" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer x:Name="TranscriptScroll" IsVisible="{Binding HasTranscript}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- **1つの部品にまとめる**（2026-09-11、人間の要望）。
                         発言ごとに分けると、またいで選べない ——
                         まとめるとドラッグで複数選べるし、Cmd+A で全部選べる。 -->
                    <vm:TranscriptLinkTextBlock x:Name="TranscriptLinks" Transcript="{Binding TranscriptText}" Classes="body"
                                         TextWrapping="Wrap" Margin="14,12"
                                         HorizontalAlignment="Stretch" />
                </ScrollViewer>
                </Panel>
            </Border>
        </DockPanel>

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

        <Border Grid.Column="4" Classes="pane">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="部門" Classes="section" Margin="0,0,0,8" />

            <!-- **どの部門も仕事を抱えていないときだけ**（設計 §52-2）。判定は仕事状態（.company/ の文書）。 -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding AllIdleQuip}" Classes="caption" TextWrapping="Wrap"
                       IsVisible="{Binding AllDepartmentsIdle}" Margin="0,0,0,8" />

            <!-- **開いたときと更新を押したときだけ取る。** 色や警告の閾値は付けない（設計 §50-2）。 -->
            <Expander DockPanel.Dock="Bottom" Classes="log" IsExpanded="False" Margin="0,8,0,0"
                      FontSize="{DynamicResource FontSizeSmall}" Expanded="OnAgentUsageExpanded">
                <Expander.Header>
                    <TextBlock Text="AIの残量" Classes="section" />
                </Expander.Header>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <Button Content="更新" Classes="quiet" Click="OnRefreshAgentUsage" />
                        <TextBlock Text="{Binding AgentUsageObservedText}" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="220">
                        <ItemsControl ItemsSource="{Binding AgentUsage}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:AgentUsageRow">
                                    <StackPanel Spacing="2" Margin="0,2,0,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <SelectableTextBlock Text="{Binding RawOutput}" IsVisible="{Binding HasRawOutput}"
                                                             TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Expander>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Departments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DepartmentTile">
                        <!-- 押すとその部門のセッションを開く（設計 §1）。 -->
                        <Button Click="OnDepartmentClick" Classes="bare" Margin="0,0,0,8">
                        <!-- **人間の出番があるタイルにだけ色が付く**（設計 §44）。
                             全部が同じ灰色の箱だと、どれを見ればよいかが絵から分からない。 -->
                        <Border Classes="card" Classes.needs-human="{Binding NeedsHuman}"
                                Classes.running="{Binding SessionBusy}">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- 3軸を混ぜず層にする（設計 §15-1）。ポーズ＝活動、バッジ＝仕事、印＝稼働。 -->
                                <!-- **選んでいる部門だけ大きく出す**（設計 §52-5）。一覧の並びは 40px のまま。 -->
                                <Grid Grid.Column="0" Width="{Binding PoseSize}" Height="{Binding PoseSize}" Margin="0,12,0,0"
                                      VerticalAlignment="Top">
                                    <!-- ポーズ＝活動状態（設計 §15-2）。24px でも見分けが付くことを確かめてある。
                                         **一言はツールチップに置く**（§52-3）—— 絵そのものと根拠の文言には混ぜない。 -->
                                    <Image Source="{Binding PoseImage}" Width="{Binding PoseSize}" Height="{Binding PoseSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Quip}" />
                                    <TextBlock Text="{Binding BadgeGlyph}" FontSize="{DynamicResource FontSizeNormal}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding RuntimeGlyph}" FontSize="{DynamicResource FontSizeNormal}"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                    <TextBlock Classes="title">
                                        <Run Text="{Binding Name}" />
                                    </TextBlock>
                                    <!-- **受理したら少しだけねぎらう**（設計 §52-4）。 -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCheer}">
                                        <Image Source="{Binding CheerImage}" Width="32" Height="32" />
                                        <TextBlock Text="{Binding CheerText}" VerticalAlignment="Center"
                                                   Classes="meta" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Agent}" Classes="meta" />
                                    <!-- **指定があるときだけ起動時の権限を出す**（設計 §51-3）。 -->
                                    <TextBlock Text="{Binding PermissionModeText}" IsVisible="{Binding HasPermissionMode}"
                                               Classes="meta" />

                                    <!-- **駆動モードは出さない**（設計 §27）。§22-4 で Tui を消したので
                                         常に Structured にしかならず、区別に使えない。
                                         代わりに **CLI が申告したモデル**を出す。観測できたときだけ ——
                                         こちらが渡した設定値は診断ビューへ（§27-3）。 -->
                                    <TextBlock Text="{Binding ModelText}" IsVisible="{Binding HasModel}"
                                               Classes="meta" />
                                    <!-- **危険モードの表示は消した**（設計 §32-3、2026-09-09）——
                                         §30-4 の抜け道そのものを廃止したので、出すものが無い。
                                         承認は人間がその部門のターミナルで押す。 -->
                                    <!-- 3軸を潰さずに並べる（設計 §7）。 -->
                                    <TextBlock Classes="meta">
                                        <Run Text="稼働 " /><Run Text="{Binding RuntimeText}" />
                                        <Run Text="　活動 " /><Run Text="{Binding ActivityText}" />
                                        <Run Text="　仕事 " /><Run Text="{Binding WorkText}" />
                                    </TextBlock>
                                    <!-- 状態だけを見せない。根拠を必ず添える（設計 §7）。 -->
                                    <TextBlock Classes="caption-1line" Text="{Binding EvidenceText}"
                                               ToolTip.Tip="{Binding EvidenceText}" IsVisible="{Binding HasEvidenceText}" />

                                    <!-- **どの仕事なのかを出す**（設計 §44-4、人間が実機で見つけた）。
                                         「この仕事を渡す」だけでは、何を渡すのか分からなかった。
                                         slug はツールチップへ —— `.company/` と突き合わせるときに要る。 -->
                                    <TextBlock Classes="meta" IsVisible="{Binding HasTaskSubject}"
                                               Text="{Binding TaskSubject}"
                                               ToolTip.Tip="{Binding CurrentTaskSlug}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />

                                    <!-- 人間の出番があることを、絵文字だけに頼らず言葉でも出す
                                         （設計 §15-5: 色や記号だけで区別しない）。 -->
                                    <TextBlock Text="◀ 選択中（直接送信の宛先）" Classes="meta"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,2,0,0" IsVisible="{Binding IsSelected}" />

                                    <!-- 文言が何をするか言っているボタン（設計 §15-6）。
                                         押す前に結果が分かるようにする。 -->
                                    <Button Content="{Binding ActionLabel}" IsVisible="{Binding HasAction}"
                                            Click="OnDepartmentAction" Classes="quiet"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" />

                                    <!-- 起動は仕事の用件と別枠（設計 §15-6）。
                                         同じ列に並べると、用件のある部門を永久に起動できない。
                                         落ちているときは出さない —— §15-4 の「原因を見てから決める」。
                                         外部ターミナルの部門では「前面に出す」になる（§32）——
                                         窓は仕事を渡したときに開くので、起動ボタンは出さない。 -->
                                    <Button Content="{Binding LifecycleLabel}" IsVisible="{Binding CanStart}"
                                            Click="OnDepartmentStart" Classes="quiet" HorizontalAlignment="Left" Margin="0,4,0,0" />

                                    <!-- **要らなくなった仕事を、目の前から外す**（設計 §44-5、人間の要望）。
                                         **消すのではない** —— 仕事も記録も `.company/` に残る（§16-4）。
                                         部門が動いていれば、それが止まる保証も無い（§14-2 と同じ姿勢）。 -->
                                    <Button Content="この仕事を取り消す" IsVisible="{Binding CanCancelTask}"
                                            Click="OnCancelTask" Classes="quiet"
                                            HorizontalAlignment="Left" Margin="0,4,0,0" />

                                    <!-- 診断は**読むだけ**（設計 §22）。v1 はターミナルを持たない。
                                         用件のボタンとは別枠 —— 人間が自分の判断で覗くもの。 -->
                                    <Button Content="診断を見る" IsVisible="{Binding IsSelected}"
                                            Click="OnShowDiagnostics" Classes="quiet" HorizontalAlignment="Left" Margin="0,4,0,0" />

                                    <!-- 報告を読んだあとに決めること（設計 §19-3）。
                                         **「報告を読む」ボタンには畳まない** —— 読む前に
                                         受理か差し戻しかは決まらない。 -->
                                    <!-- レビューに回っている間は決めさせない（設計 §62-17）。代わりに誰が見ているかを出す。 -->
                                    <TextBlock Text="{Binding UnderReviewText}" IsVisible="{Binding IsUnderReview}"
                                               Classes="meta" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <Button Content="受理する" IsVisible="{Binding CanJudgeReport}"
                                            Click="OnAcceptReport" Classes="quiet" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    <!-- 理由も複数行で書ける（設計 §62-28）。送信は Tunnel（code-behind）。 -->
                                    <TextBox Text="{Binding RejectionDraft, Mode=TwoWay}"
                                             IsVisible="{Binding CanJudgeReport}"
                                             AttachedToVisualTree="OnRejectionBoxAttached" Classes="input"
                                             PlaceholderText="差し戻す理由（Shift+Enter で差し戻す）"
                                             FontSize="{DynamicResource FontSizeSmall}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Margin="0,4,0,0" />
                                    <Button Content="差し戻して送り直す" IsVisible="{Binding CanJudgeReport}"
                                            Click="OnRejectReport" Classes="quiet" HorizontalAlignment="Left" Margin="0,4,0,0" />

                                    <!-- 部門への操作は右ペインに置く（設計 §17-4）。
                                         中央の入力欄は秘書のもの。 -->
                                    <!-- 部門への指示は**中央の入力欄と別**（設計 §17-4）。
                                         秘書が outbox に publish する経路が入るまでの暫定。 -->
                                    <TextBox Text="{Binding TaskDraft, Mode=TwoWay}" IsVisible="{Binding IsSelected}"
                                             AttachedToVisualTree="OnTaskDraftBoxAttached"
                                             PlaceholderText="この部門への指示（Shift+Enter で仕事にする）" FontSize="{DynamicResource FontSizeSmall}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Margin="0,4,0,0" />
                                    <Button Content="この部門に仕事を作る" IsVisible="{Binding IsSelected}"
                                            Click="OnMakeTask" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        </Border>

    </Grid>
    </DockPanel>
</Window>
