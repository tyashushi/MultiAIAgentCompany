<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MultiAIAgentCompany.Desktop"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MultiAIAgentCompany.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="800"
        Title="MultiAIAgentCompany">

    <!-- 3ペイン（設計 §1）。左＝作業ログ、中央＝秘書との会話、右＝部門ステータス。 -->
    <Grid ColumnDefinitions="260,4,*,4,320" Margin="8">

        <DockPanel Grid.Column="0">
            <!-- 起動時の復旧走査（設計 §14-1 / §16-3）。**一過性のログ行にしない** ——
                 流れて消えると、自動再送しない契約を人間が守れない。
                 Unreadable は部門に紐づけられないので、ここにしか出せない。 -->
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasRecovery}" Margin="0,0,0,8">
                <TextBlock Text="確かめてほしいこと" FontWeight="Bold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Recovery}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RecoveryItem">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <Run Text="{Binding KindText}" /><Run Text=" — " /><Run Text="{Binding Slug}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Opacity="0.8" />

                                    <!-- 人間が決めた結果を記録できるようにする（設計 §16-4）。
                                         「まだ決めない」は選択肢を出さない —— 何もしなければ残る。 -->
                                    <WrapPanel IsVisible="{Binding IsMaybeSent}" Margin="0,4,0,0">
                                        <Button Content="受け取って作業中だった" FontSize="11" Margin="0,0,4,4"
                                                Click="OnRecoveryConfirmDelivered" />
                                        <Button Content="もう一度送る（二重に実行されるかも）" FontSize="11" Margin="0,0,4,4"
                                                Click="OnRecoveryResend" />
                                        <Button Content="アプリ上で取り消す" FontSize="11" Margin="0,0,4,4"
                                                Click="OnRecoveryCancel" />
                                    </WrapPanel>

                                    <WrapPanel IsVisible="{Binding IsUnreadable}" Margin="0,4,0,0">
                                        <Button Content="フォルダを開く" FontSize="11" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="隔離する" FontSize="11" Margin="0,0,4,4"
                                                Click="OnRecoveryQuarantine" />
                                        <Button Content="もう一度読む" FontSize="11" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="作業ログ" FontWeight="Bold" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding WorkLog}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="秘書 — " FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceLabel}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" x:Name="PickWorkspaceButton" Click="OnPickWorkspace"
                            Content="フォルダを選ぶ" Margin="6,0,0,0" />
                </Grid>

                <!-- trust は3値（設計 §13-9）。「未 trust」と「判定できない」を同じにしない ——
                     読めていないだけなのに、人間へ無用な操作を促すことになる。
                     アプリは trust を書かない。どこで与えるかを伝えるに留める。 -->
                <ItemsControl ItemsSource="{Binding Trust}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:TrustRow">
                            <Grid ColumnDefinitions="110,90,*" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding AgentText}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Text="{Binding ActionText}" FontSize="11"
                                           Opacity="0.75" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--
                入力欄経由でのみ文章を送る（設計 §13-7）。ターミナルに直接打たせない。
                実測: TerminalView は IME の変換中でもキーから作った文字を即 PTY へ送るため、
                「?」や Enter が漏れる。TextBox 経路なら確定文字だけが入る。
                また IME の変換確定 Enter は KeyDown として届かないので、
                入力欄では素の Enter を送信に使ってよい。
            -->
            <!-- **これは調整基盤の経路ではない**（§6 / §14-1）——
                 本来は秘書が instruction.md を書き、アプリが dispatch する。
                 ここは配線を実物で確かめるための直通路。秘書はまだ繋がっていない。 -->
            <!-- ボタンは2つ。**文言が何をするか言う**（設計 §16-2 / §15-6）——
                 「送信」では、仕事を作るのかただの一言なのかが分からない。 -->
            <!-- **中央の入力欄は秘書だけのもの**（設計 §17-4）。
                 同じ入力欄が秘書・部門・仕事作成という複数の文脈を背負うと §0 / §1 と衝突する。
                 部門への操作は右ペインへ移した。 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <TextBlock Text="{Binding SecretaryStatus}" FontSize="11" Opacity="0.75"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" x:Name="MessageBox" AcceptsReturn="False"
                             PlaceholderText="秘書に相談する（日本語で書ける）" />
                    <!-- 未起動なら、その副作用として起動する（§17-4）。 -->
                    <Button Grid.Column="1" Content="秘書に送る" Margin="6,0,0,0" Click="OnSendToSecretary" />
                </Grid>
            </StackPanel>

            <!-- 秘書の提案（設計 §17-6）。**「仕事にする」は自由入力欄ではなく、
                 この具体的な提案に出す**（§17-4）。 -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Proposals}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProposalCard">
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="秘書からの提案 → " /><Run Text="{Binding TargetText}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,2,0,0" MaxHeight="120" />
                                <WrapPanel Margin="0,6,0,0">
                                    <!-- 宛先が分からない提案は仕事にできない。**捨てもしない**（§17-6）。 -->
                                    <Button Content="仕事にする" IsEnabled="{Binding CanMakeTask}"
                                            FontSize="11" Margin="0,0,4,0" Click="OnProposalAccept" />
                                    <Button Content="やめる" FontSize="11" Click="OnProposalReject" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ProblemText}"
                                           IsVisible="{Binding HasProblem}" FontSize="11" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- (a) ランタイム承認。ボタンは提示された決定から作る（設計 §5）——
                 版で変わる語彙をここに書き足さない。
                 (b) 判断の相談はここに出さない。あれは .company/ のファイルで扱う（§3 / §6）。 -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Approvals.Pending}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PendingApproval">
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                BorderThickness="2" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="承認まち: " /><Run Text="{Binding DepartmentName}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                           FontSize="11" Opacity="0.8" />

                                <!-- 「今回だけ / 常に許可」の材料（§13-1）。安全な要約だけで、
                                     ツールの入力そのものは含まない（§10）。v1 は読むだけ。 -->
                                <ItemsControl ItemsSource="{Binding SuggestedRules}"
                                              IsVisible="{Binding HasSuggestions}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Decisions}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,6,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:PendingApproval)DataContext).RespondCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 返事が届かなかったことを、届いたことにしない。 -->
                                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4">
                <ItemsControl ItemsSource="{Binding SecretaryTranscript}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DockPanel>

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Text="部門" FontWeight="Bold" Margin="0,0,0,6" />

            <ItemsControl ItemsSource="{Binding Departments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DepartmentTile">
                        <!-- 押すとその部門のセッションを開く（設計 §1）。 -->
                        <Button Click="OnDepartmentClick" Padding="0" Margin="0,0,0,6"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                        <Border BorderThickness="1" CornerRadius="4" Padding="8"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- 3軸を混ぜず層にする（設計 §15-1）。ポーズ＝活動、バッジ＝仕事、印＝稼働。 -->
                                <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Glyph}" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BadgeGlyph}" FontSize="13"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding RuntimeGlyph}" FontSize="13"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding Name}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Agent}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Mode}" />
                                    </TextBlock>
                                    <!-- 3軸を潰さずに並べる（設計 §7）。 -->
                                    <TextBlock FontSize="11" Opacity="0.8">
                                        <Run Text="稼働 " /><Run Text="{Binding RuntimeText}" />
                                        <Run Text="  活動 " /><Run Text="{Binding ActivityText}" />
                                        <Run Text="  仕事 " /><Run Text="{Binding WorkText}" />
                                    </TextBlock>
                                    <!-- 状態だけを見せない。根拠を必ず添える（設計 §7）。 -->
                                    <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                               Text="{Binding EvidenceText}" />

                                    <!-- 人間の出番があることを、絵文字だけに頼らず言葉でも出す
                                         （設計 §15-5: 色や記号だけで区別しない）。 -->
                                    <TextBlock Text="◀ 選択中（直接送信の宛先）" FontSize="11"
                                               Margin="0,2,0,0" IsVisible="{Binding IsSelected}" />

                                    <!-- 文言が何をするか言っているボタン（設計 §15-6）。
                                         押す前に結果が分かるようにする。 -->
                                    <Button Content="{Binding ActionLabel}" IsVisible="{Binding HasAction}"
                                            Click="OnDepartmentAction" Margin="0,6,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <!-- 起動は仕事の用件と別枠（設計 §15-6）。
                                         同じ列に並べると、用件のある部門を永久に起動できない。
                                         落ちているときは出さない —— §15-4 の「原因を見てから決める」。 -->
                                    <Button Content="起動する" IsVisible="{Binding CanStart}"
                                            Click="OnDepartmentStart" FontSize="11" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <!-- 診断は**読むだけ**（設計 §22）。v1 はターミナルを持たない。
                                         用件のボタンとは別枠 —— 人間が自分の判断で覗くもの。 -->
                                    <Button Content="診断を見る" IsVisible="{Binding IsSelected}"
                                            Click="OnShowDiagnostics" FontSize="11" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <!-- 報告を読んだあとに決めること（設計 §19-3）。
                                         **「報告を読む」ボタンには畳まない** —— 読む前に
                                         受理か差し戻しかは決まらない。 -->
                                    <Button Content="受理する" IsVisible="{Binding CanJudgeReport}"
                                            Click="OnAcceptReport" FontSize="11" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                    <TextBox Text="{Binding RejectionDraft, Mode=TwoWay}"
                                             IsVisible="{Binding CanJudgeReport}"
                                             PlaceholderText="差し戻す理由（次の指示に入る）" FontSize="11"
                                             AcceptsReturn="False" Margin="0,4,0,0" />
                                    <Button Content="差し戻して送り直す" IsVisible="{Binding CanJudgeReport}"
                                            Click="OnRejectReport" FontSize="11" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <!-- 部門への操作は右ペインに置く（設計 §17-4）。
                                         中央の入力欄は秘書のもの。 -->
                                    <!-- 部門への指示は**中央の入力欄と別**（設計 §17-4）。
                                         秘書が outbox に publish する経路が入るまでの暫定。 -->
                                    <TextBox Text="{Binding TaskDraft, Mode=TwoWay}" IsVisible="{Binding IsSelected}"
                                             PlaceholderText="この部門への指示" FontSize="11"
                                             AcceptsReturn="False" Margin="0,4,0,0" />
                                    <Button Content="この部門に仕事を作る" IsVisible="{Binding IsSelected}"
                                            Click="OnMakeTask" FontSize="11" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

    </Grid>
</Window>
