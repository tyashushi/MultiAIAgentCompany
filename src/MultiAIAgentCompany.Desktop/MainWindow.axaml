<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MultiAIAgentCompany.Desktop"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MultiAIAgentCompany.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="800"
        Title="MultiAIAgentCompany">

    <!-- 3ペイン（設計 §1）。左＝作業ログ、中央＝秘書との会話、右＝部門ステータス。 -->
    <!-- macOS の標準メニュー（設計 §28-7）。ショートカットの所在をここで示す ——
         キーだけ足しても、人間はそれが在ることを知らない。 -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="ファイル">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="フォルダを選ぶ…" Gesture="Cmd+O" Click="OnPickWorkspaceFromMenu" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="いま開いているフォルダを Finder で開く" Gesture="Cmd+Shift+O"
                                        Click="OnRevealWorkspace" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="表示">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="もう一度走査する" Gesture="Cmd+R" Click="OnRescanFromMenu" />
                        <NativeMenuItem Header="作業ログを消す" Click="OnClearWorkLog" />
                        <NativeMenuItem Header="直近のエラーの詳細を出す" Click="OnShowLastErrors" />
                        <NativeMenuItem Header="会話を全部コピーする" Gesture="Cmd+Shift+C" Click="OnCopyTranscript" />
                        <NativeMenuItem Header="作業ログを全部コピーする" Gesture="Cmd+Shift+L" Click="OnCopyWorkLog" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="アイコンの一覧を見る" Click="OnShowIconGallery" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="入力欄へ移動" Gesture="Cmd+L" Click="OnFocusMessage" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Grid x:Name="PaneGrid" ColumnDefinitions="260,4,*,4,320" Margin="8">

        <DockPanel Grid.Column="0">
            <!-- 起動時の復旧走査（設計 §14-1 / §16-3）。**一過性のログ行にしない** ——
                 流れて消えると、自動再送しない契約を人間が守れない。
                 Unreadable は部門に紐づけられないので、ここにしか出せない。 -->
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasRecovery}" Margin="0,0,0,8">
                <TextBlock Text="確かめてほしいこと" FontWeight="Bold" Margin="0,0,0,4" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                <ItemsControl ItemsSource="{Binding Recovery}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RecoveryItem">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold">
                                        <Run Text="{Binding KindText}" /><Run Text=" — " /><Run Text="{Binding Slug}" />
                                    </TextBlock>
                                    <SelectableTextBlock Text="{Binding Detail}" FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap" Opacity="0.8" />

                                    <!-- 人間が決めた結果を記録できるようにする（設計 §16-4）。
                                         「まだ決めない」は選択肢を出さない —— 何もしなければ残る。 -->
                                    <WrapPanel IsVisible="{Binding IsMaybeSent}" Margin="0,4,0,0">
                                        <Button Content="受け取って作業中だった" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryConfirmDelivered" />
                                        <Button Content="もう一度送る（二重に実行されるかも）" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryResend" />
                                        <Button Content="アプリ上で取り消す" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryCancel" />
                                    </WrapPanel>

                                    <!-- 読めない lease（設計 §23-1）。**自動で作り直さない** ——
                                         読めない lease は「誰も持っていない」ではなく
                                         「持ち主を検証できない」。 -->
                                    <WrapPanel IsVisible="{Binding IsUnreadableLease}" Margin="0,4,0,0">
                                        <Button Content="フォルダを開く" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="隔離して空の書き込み権を作る" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryIsolateLease" />
                                        <Button Content="もう一度読む" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>

                                    <!-- 失効した書き込み権（設計 §24-2）。**時間では空かない。**
                                         外す根拠は時間ではなく、人間が「もう動いていない」と
                                         判断したこと（§14-2）。 -->
                                    <WrapPanel IsVisible="{Binding IsExpiredLease}" Margin="0,4,0,0">
                                        <Button Content="失効した書き込み権を外す" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryReleaseExpiredLease" />
                                        <Button Content="フォルダを開く" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="もう一度読む" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>

                                    <!-- 設定の話は**人間が直す**（設計 §32-10）。
                                         アプリは departments.json を書き換えない（§30-4 / §30-6）ので、
                                         出すのは開く手立てだけ。 -->
                                    <WrapPanel IsVisible="{Binding IsConfiguration}" Margin="0,4,0,0">
                                        <Button Content="フォルダを開く" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="もう一度読む" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>

                                    <WrapPanel IsVisible="{Binding IsUnreadable}" Margin="0,4,0,0">
                                        <Button Content="フォルダを開く" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryOpenFolder" />
                                        <Button Content="隔離する" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryQuarantine" />
                                        <Button Content="もう一度読む" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,4"
                                                Click="OnRecoveryRescan" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- **作業ログは畳んで下へ**（設計 §32-6）。左ペインの主役は相談スレッド ——
                 初期ブリーフの「左＝チャットログ一覧」を、途中で
                 「システムの作業実行ログ」と取り違えていた。 -->
            <Expander DockPanel.Dock="Bottom" Header="作業ログ" IsExpanded="False" Margin="0,6,0,0"
                      FontSize="{DynamicResource FontSizeSmall}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="220">
                    <!-- **1つの部品にまとめる**（人間の要望、2026-09-12）——
                         1行ずつ別の部品にすると、**ドラッグで行をまたいで選べない。**
                         会話では §34-4 で既に解いていた問題（§37-10）。 -->
                    <SelectableTextBlock Text="{Binding WorkLogText}" TextWrapping="Wrap" Margin="0,2" />
                </ScrollViewer>
            </Expander>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="相談" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="＋ 新しい相談" Click="OnNewThread" HorizontalAlignment="Right"
                        FontSize="{DynamicResource FontSizeSmall}" />
            </DockPanel>

            <!-- **スクロールできること**（設計 §25-1）。無いと、はみ出した行に手が届かない。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Threads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnThreadSelected" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Margin="0,1">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- 選んでいるものに印を付ける。**色に頼らない**
                                             （§28 でローカライズはやらないと決めたのと同じ姿勢で、
                                             見分けは形で付ける）。 -->
                                        <TextBlock Text="▸ " IsVisible="{Binding IsSelected}" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding UpdatedText}" Opacity="0.6"
                                               FontSize="{DynamicResource FontSizeSmall}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="秘書 — " FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceLabel}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" x:Name="PickWorkspaceButton" Click="OnPickWorkspace"
                            Content="フォルダを選ぶ" Margin="6,0,0,0" />
                </Grid>

                <!-- trust は3値（設計 §13-9）。「未 trust」と「判定できない」を同じにしない ——
                     読めていないだけなのに、人間へ無用な操作を促すことになる。
                     アプリは trust を書かない。どこで与えるかを伝えるに留める。 -->
                <ItemsControl ItemsSource="{Binding Trust}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:TrustRow">
                            <Grid ColumnDefinitions="110,90,*" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding AgentText}" FontSize="{DynamicResource FontSizeSmall}" />
                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Text="{Binding ActionText}" FontSize="{DynamicResource FontSizeSmall}"
                                           Opacity="0.75" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--
                入力欄経由でのみ文章を送る（設計 §13-7）。ターミナルに直接打たせない。
                実測: TerminalView は IME の変換中でもキーから作った文字を即 PTY へ送るため、
                「?」や Enter が漏れる。TextBox 経路なら確定文字だけが入る。
                また IME の変換確定 Enter は KeyDown として届かないので、
                入力欄では素の Enter を送信に使ってよい。
            -->
            <!-- **これは調整基盤の経路ではない**（§6 / §14-1）——
                 本来は秘書が instruction.md を書き、アプリが dispatch する。
                 ここは配線を実物で確かめるための直通路。秘書はまだ繋がっていない。 -->
            <!-- ボタンは2つ。**文言が何をするか言う**（設計 §16-2 / §15-6）——
                 「送信」では、仕事を作るのかただの一言なのかが分からない。 -->
            <!-- **中央の入力欄は秘書だけのもの**（設計 §17-4）。
                 同じ入力欄が秘書・部門・仕事作成という複数の文脈を背負うと §0 / §1 と衝突する。
                 部門への操作は右ペインへ移した。 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <!-- 走っている計画（設計 §37）。**人間の出番は割り込みだけ** ——
                     報告は出た瞬間に中央へ出るので、読んでいてまずいと思ったら止める。
                     **止めるのは「次を渡さない」こと。走っている窓は閉じない**（§32-8）。
                     **「続ける」を一緒に出す** —— 無いと、一度止めた計画を
                     進める手段が画面から消える（§19-1 / §30-2 で3度踏んだ形）。 -->
                <Border IsVisible="{Binding HasPlan}" Margin="0,0,0,6" Padding="8" CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- **選んでコピーできるようにする**（人間の要望、2026-09-12）——
                             ここに出るのは**渡せなかった理由**で、人間はそれを人に見せたり
                             調べたりする。読めるだけでは足りない（作業ログは §34-4 で既にそう）。 -->
                        <SelectableTextBlock Grid.Column="0" Text="{Binding PlanStatus}" TextWrapping="Wrap"
                                             FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="計画を止める" Margin="8,0,0,0"
                                    IsVisible="{Binding PlanRunning}" Click="OnStopPlan" />
                            <Button Content="計画を続ける" Margin="8,0,0,0"
                                    IsVisible="{Binding PlanStopped}" Click="OnResumePlan" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- turn の終わりを期限までに観測していない（設計 §36）。
                     **状態は動かしていない** —— 出しているのは「観測していない」という
                     アプリ自身についての事実で、秘書が止まったとは言っていない（§31-5）。
                     用件は1つだけ: **観測できる終端を作る**（= プロセスを終わらせる）。 -->
                <Border IsVisible="{Binding SecretaryStalled}" Margin="0,0,0,6" Padding="8" CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <SelectableTextBlock Grid.Column="0" Text="{Binding SecretaryStalledText}" TextWrapping="Wrap"
                                             FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="秘書を立て直す" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="OnRestartSecretary" />
                    </Grid>
                </Border>
                <SelectableTextBlock Text="{Binding SecretaryStatus}" FontSize="{DynamicResource FontSizeSmall}"
                                     Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto">
                    <!-- **素の Enter で送る**（設計 §13-7 の実測）。IME の確定 Enter は
                         KeyDown として届かないので、確定と送信は衝突しない。 -->
                    <TextBox Grid.Column="0" x:Name="MessageBox" AcceptsReturn="False"
                             KeyDown="OnMessageKeyDown"
                             PlaceholderText="秘書に相談する（Enter で送る）" />
                    <!-- 未起動なら、その副作用として起動する（§17-4）。 -->
                    <Button Grid.Column="1" Content="秘書に送る" Margin="6,0,0,0" Click="OnSendToSecretary" />
                </Grid>
            </StackPanel>

            <!-- 秘書の提案（設計 §17-6 / §34-1）。
                 **提案は publish されると自動で仕事になる**（§34-1）ので、
                 ここに並ぶのは**自動にできなかったもの**（宛先が分からない等）か、
                 走査が拾うまでの短い間だけ。**捨てないので、理由と一緒に出す。** -->
            <!-- 提案も同じ（§25-1）。増えたら会話が見えなくなるので高さを区切る。 -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="260">
            <ItemsControl ItemsSource="{Binding Proposals}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProposalCard">
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="秘書からの提案 → " /><Run Text="{Binding TargetText}" />
                                </TextBlock>
                                <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                           Margin="0,2,0,0" MaxHeight="120" />
                                <WrapPanel Margin="0,6,0,0">
                                    <!-- 宛先が分からない提案は仕事にできない。**捨てもしない**（§17-6）。 -->
                                    <!-- 自動で拾えなかったときの手動の口（§34-1）。 -->
                                    <Button Content="仕事にする" IsEnabled="{Binding CanMakeTask}"
                                            FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,0" Click="OnProposalAccept" />
                                    <Button Content="やめる" FontSize="{DynamicResource FontSizeSmall}" Click="OnProposalReject" />
                                </WrapPanel>
                                <SelectableTextBlock Text="{Binding ProblemText}"
                                           IsVisible="{Binding HasProblem}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- (a) ランタイム承認。ボタンは提示された決定から作る（設計 §5）——
                 版で変わる語彙をここに書き足さない。
                 (b) 判断の相談はここに出さない。あれは .company/ のファイルで扱う（§3 / §6）。 -->
            <!-- **承認は画面外に出してはいけない**（設計 §25-1 / §15-6）。数が増えると
                 ボタンが下へ押し出されて押せなくなる。高さを区切ってスクロールさせる。 -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="260">
            <ItemsControl ItemsSource="{Binding Approvals.Pending}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PendingApproval">
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                BorderThickness="2" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="承認まち: " /><Run Text="{Binding DepartmentName}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8" />

                                <!-- 「今回だけ / 常に許可」の材料（§13-1）。安全な要約だけで、
                                     ツールの入力そのものは含まない（§10）。v1 は読むだけ。 -->
                                <ItemsControl ItemsSource="{Binding SuggestedRules}"
                                              IsVisible="{Binding HasSuggestions}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Decisions}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,6,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:PendingApproval)DataContext).RespondCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 返事が届かなかったことを、届いたことにしない。 -->
                                <SelectableTextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                                                     TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                                     Margin="0,4,0,0" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- **最初に何をすればよいかを出す**（設計 §28-2）。フォルダを選ぶまでは
                 中央に説明を置く —— 空の3ペインだけだと、初見では何をするか分からない。 -->
            <Border IsVisible="{Binding !HasWorkspace}" Margin="0,0,0,8" Padding="16"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="AI たちを部門として働かせるアプリです" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarge}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85"
                               Text="Claude Code / Codex CLI / Antigravity CLI を「部門」として扱います。あなたは秘書と会話し、秘書が仕事を各部門に渡します。" />
                    <TextBlock Text="はじめかた" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="1. 右上の「フォルダを選ぶ」で、AI たちに作業させるフォルダを選ぶ" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="2. 左下に各 CLI の状態が出ます（見つからない / 未 trust なら、そこに対処が書いてあります）" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="3. 下の入力欄から秘書に話しかける。部門は右のパネルから起動します" />
                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7"
                               Text="※ 選んだフォルダの .company/ を通じて、アプリと部門がやりとりします。アプリを閉じると、起動した CLI もすべて終了します。" />
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4">
                <!-- 会話は下に伸びるので、新しい発言が来たら最下部へ追う（§25-1）。 -->
                <ScrollViewer x:Name="TranscriptScroll"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- **1つの部品にまとめる**（2026-09-11、人間の要望）。
                         発言ごとに分けると、またいで選べない ——
                         まとめるとドラッグで複数選べるし、Cmd+A で全部選べる。 -->
                    <SelectableTextBlock Text="{Binding TranscriptText}" TextWrapping="Wrap" Margin="8" />
                </ScrollViewer>
            </Border>
        </DockPanel>

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Text="部門" FontWeight="Bold" Margin="0,0,0,6" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Departments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DepartmentTile">
                        <!-- 押すとその部門のセッションを開く（設計 §1）。 -->
                        <Button Click="OnDepartmentClick" Padding="0" Margin="0,0,0,6"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                        <Border BorderThickness="1" CornerRadius="4" Padding="8"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- 3軸を混ぜず層にする（設計 §15-1）。ポーズ＝活動、バッジ＝仕事、印＝稼働。 -->
                                <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0">
                                    <!-- ポーズ＝活動状態（設計 §15-2）。24px でも見分けが付くことを確かめてある。 -->
                                    <Image Source="{Binding PoseImage}" Width="40" Height="40"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BadgeGlyph}" FontSize="{DynamicResource FontSizeNormal}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding RuntimeGlyph}" FontSize="{DynamicResource FontSizeNormal}"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding Name}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Agent}" />
                                    </TextBlock>

                                    <!-- **駆動モードは出さない**（設計 §27）。§22-4 で Tui を消したので
                                         常に Structured にしかならず、区別に使えない。
                                         代わりに **CLI が申告したモデル**を出す。観測できたときだけ ——
                                         こちらが渡した設定値は診断ビューへ（§27-3）。 -->
                                    <TextBlock Text="{Binding ModelText}" IsVisible="{Binding HasModel}"
                                               FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8" />
                                    <!-- **危険モードの表示は消した**（設計 §32-3、2026-09-09）——
                                         §30-4 の抜け道そのものを廃止したので、出すものが無い。
                                         承認は人間がその部門のターミナルで押す。 -->
                                    <!-- 3軸を潰さずに並べる（設計 §7）。 -->
                                    <TextBlock FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8">
                                        <Run Text="稼働 " /><Run Text="{Binding RuntimeText}" />
                                        <Run Text="  活動 " /><Run Text="{Binding ActivityText}" />
                                        <Run Text="  仕事 " /><Run Text="{Binding WorkText}" />
                                    </TextBlock>
                                    <!-- 状態だけを見せない。根拠を必ず添える（設計 §7）。 -->
                                    <TextBlock FontSize="{DynamicResource FontSizeSmall}" Opacity="0.6" TextWrapping="Wrap"
                                               Text="{Binding EvidenceText}" />

                                    <!-- 人間の出番があることを、絵文字だけに頼らず言葉でも出す
                                         （設計 §15-5: 色や記号だけで区別しない）。 -->
                                    <TextBlock Text="◀ 選択中（直接送信の宛先）" FontSize="{DynamicResource FontSizeSmall}"
                                               Margin="0,2,0,0" IsVisible="{Binding IsSelected}" />

                                    <!-- 文言が何をするか言っているボタン（設計 §15-6）。
                                         押す前に結果が分かるようにする。 -->
                                    <Button Content="{Binding ActionLabel}" IsVisible="{Binding HasAction}"
                                            Click="OnDepartmentAction" Margin="0,6,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <!-- 起動は仕事の用件と別枠（設計 §15-6）。
                                         同じ列に並べると、用件のある部門を永久に起動できない。
                                         落ちているときは出さない —— §15-4 の「原因を見てから決める」。
                                         外部ターミナルの部門では「前面に出す」になる（§32）——
                                         窓は仕事を渡したときに開くので、起動ボタンは出さない。 -->
                                    <Button Content="{Binding LifecycleLabel}" IsVisible="{Binding CanStart}"
                                            Click="OnDepartmentStart" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <!-- 診断は**読むだけ**（設計 §22）。v1 はターミナルを持たない。
                                         用件のボタンとは別枠 —— 人間が自分の判断で覗くもの。 -->
                                    <Button Content="診断を見る" IsVisible="{Binding IsSelected}"
                                            Click="OnShowDiagnostics" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <!-- 報告を読んだあとに決めること（設計 §19-3）。
                                         **「報告を読む」ボタンには畳まない** —— 読む前に
                                         受理か差し戻しかは決まらない。 -->
                                    <Button Content="受理する" IsVisible="{Binding CanJudgeReport}"
                                            Click="OnAcceptReport" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                    <TextBox Text="{Binding RejectionDraft, Mode=TwoWay}"
                                             IsVisible="{Binding CanJudgeReport}"
                                             KeyDown="OnRejectionKeyDown"
                                             PlaceholderText="差し戻す理由（Enter で差し戻す）" FontSize="{DynamicResource FontSizeSmall}"
                                             AcceptsReturn="False" Margin="0,4,0,0" />
                                    <Button Content="差し戻して送り直す" IsVisible="{Binding CanJudgeReport}"
                                            Click="OnRejectReport" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <!-- 部門への操作は右ペインに置く（設計 §17-4）。
                                         中央の入力欄は秘書のもの。 -->
                                    <!-- 部門への指示は**中央の入力欄と別**（設計 §17-4）。
                                         秘書が outbox に publish する経路が入るまでの暫定。 -->
                                    <TextBox Text="{Binding TaskDraft, Mode=TwoWay}" IsVisible="{Binding IsSelected}"
                                             KeyDown="OnTaskDraftKeyDown"
                                             PlaceholderText="この部門への指示（Enter で仕事にする）" FontSize="{DynamicResource FontSizeSmall}"
                                             AcceptsReturn="False" Margin="0,4,0,0" />
                                    <Button Content="この部門に仕事を作る" IsVisible="{Binding IsSelected}"
                                            Click="OnMakeTask" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>

    </Grid>
</Window>
