<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core を表示するだけの薄い層（設計 §4）。 -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MultiAIAgentCompany.Desktop</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MultiAIAgentCompany.Core/MultiAIAgentCompany.Core.csproj" />
  </ItemGroup>

  <!-- 人型アイコン（設計 §15）。**この行が要る** —— 外して測ったら、
       アセンブリに埋まらなかった（Avalonia は Assets/** を自動では拾わない）。 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>


</Project>
