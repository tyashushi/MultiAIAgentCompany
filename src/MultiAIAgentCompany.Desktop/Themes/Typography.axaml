<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 文字の階層（設計 §44）。**主・従・補足の3段だけ**にする。
         直す前は、部門名と状態行がほぼ同じ濃さで並んでいて、目が迷っていた。
         **クラスで分ける** —— TextBlock 全体を上書きすると、メニューやダイアログまで動く。 -->

    <!-- **日本語を明示する**（設計 §44-6、実機で踏んだ）。
         アプリの既定は Inter（`.WithInterFont()`）で、**Inter に日本語の字が無い** ——
         指定しない窓では、日本語が □ になる（太字だけは Inter に無いので別のフォントに落ち、
         **読める行と読めない行が混ざる**という形で出た）。
         **窓ごとに書かない。** 書き忘れた窓が化ける（閉じる確認のダイアログで踏んだ）。 -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter, Hiragino Sans" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.meta">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 補足。**薄くしすぎない** —— 状態の確認に使うものは読めなくてはいけない。 -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 1行に収める補足。**消さずに畳む**（設計 §7 の根拠は残す）——
         全文は tooltip と「診断を見る」で読める。 -->
    <Style Selector="TextBlock.caption-1line">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="SelectableTextBlock.body">
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
</Styles>
